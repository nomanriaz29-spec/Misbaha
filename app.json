{
  "expo": {
    "name": "Ratb",
    "slug": "misbaha",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3c8133b8-823c-4a51-8868-5ab493b08bc3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "misbaha",
    "ios": {
      "bundleIdentifier": "com.nomanriaz.misbaha",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.nomanriaz.misbaha"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.nomanriaz.misbaha",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1A19"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ratb uses your location to calculate accurate prayer times and remind you after each prayer."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D6A651",
          "sounds": [
            "./assets/sounds/azan.wav",
            "./assets/sounds/alarm.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0F1A19"
        }
      ],
      "expo-background-task",
      "expo-font",
      "@bacons/apple-targets",
      "expo-status-bar",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RatbPrayerTimes",
              "label": "Prayer times",
              "description": "The next prayer and today’s five times",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/prayer-times.png"
            },
            {
              "name": "RatbTodayPrayers",
              "label": "Today’s prayers",
              "description": "All five prayer times in a small square",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "250dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/today-prayers.png"
            },
            {
              "name": "RatbSalah",
              "label": "Salah tracker",
              "description": "Tick each prayer as you pray it",
              "minWidth": "250dp",
              "minHeight": "50dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/salah.png"
            },
            {
              "name": "RatbNextPrayer",
              "label": "Next prayer",
              "description": "The next prayer and its time",
              "minWidth": "110dp",
              "minHeight": "50dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "300dp",
              "maxResizeHeight": "120dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/next-prayer.png"
            },
            {
              "name": "RatbVerse",
              "label": "Verse of the day",
              "description": "A verse of the Quran with its meaning, new every day",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/verse.png"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.nomanriaz.misbaha.prayerwidget",
                  "targetName": "PrayerWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.nomanriaz.misbaha"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "3c8133b8-823c-4a51-8868-5ab493b08bc3"
      },
      "supportsRTL": true
    }
  }
}
